+"""Asset location helpers for the whole_body_tracking extension.
+
+Robot description files are not checked into this repository. They are pulled from the Unitree
+description tarball documented in the repository README:
+
+.. code-block:: bash
+
+    curl -L -o unitree_description.tar.gz \\
+      https://storage.googleapis.com/qiayuanl_robot_descriptions/unitree_description.tar.gz && \\
+    tar -xzf unitree_description.tar.gz -C source/whole_body_tracking/whole_body_tracking/assets/
+
+A missing asset used to fail late and quietly: Isaac Sim reports the unresolved geometry with only
+``Failed to find rigid body at ...`` warnings and continues, so the fault surfaces as a policy that
+trains against a robot with no visual/collision meshes. :func:`require_asset` turns that into an
+immediate, actionable error instead.
+"""
+
 import os
 
 # Conveniences to other module directories via relative paths
 ASSET_DIR = os.path.abspath(os.path.dirname(__file__))
+
+
+def asset_path(*parts: str) -> str:
+    """Return an absolute path inside the extension's asset directory."""
+    return os.path.join(ASSET_DIR, *parts)
+
+
+def require_asset(*parts: str, hint: str | None = None) -> str:
+    """Return the absolute path of an asset, raising a clear error when it is absent.
+
+    Args:
+        *parts: Path components relative to :data:`ASSET_DIR`.
+        hint: Optional extra guidance appended to the error message.
+
+    Returns:
+        The absolute path of the asset.
+
+    Raises:
+        FileNotFoundError: If the asset does not exist on disk.
+    """
+    path = asset_path(*parts)
+    if not os.path.exists(path):
+        rel = os.path.join(*parts)
+        message = (
+            f"Required asset is missing: {path}\n"
+            f"Expected '{rel}' under the extension asset directory:\n  {ASSET_DIR}\n"
+            "Fetch the robot description files with (from the repository root):\n"
+            "  curl -L -o unitree_description.tar.gz "
+            "https://storage.googleapis.com/qiayuanl_robot_descriptions/unitree_description.tar.gz\n"
+            "  tar -xzf unitree_description.tar.gz -C "
+            "source/whole_body_tracking/whole_body_tracking/assets/"
+        )
+        if hint:
+            message += f"\n{hint}"
+        raise FileNotFoundError(message)
+    return path
