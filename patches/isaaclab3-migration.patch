+def upload_to_wandb(onnx_path: str, run_path: str | None = None, artifact_name: str = "motion_policy") -> None:
+    """Upload an exported ONNX policy to Weights & Biases.
+
+    Models upload as a run artifact (``wandb.save``) and, when ``run_path`` identifies a run, get
+    linked to it so the export is discoverable from the training run.
+
+    ``torch.onnx.export`` stores weights in an external data file (``<name>.onnx.data``) once the
+    model exceeds the inline size limit. That sibling file is *not* picked up by
+    ``Artifact.add_file`` on its own, and an artifact holding only the ``.onnx`` graph fails to load,
+    so every ``<name>.onnx*`` sibling is added explicitly.
+
+    Args:
+        onnx_path: Path of the ONNX file to upload.
+        run_path: Optional W&B run identifier (``entity/project/run_id``) used for provenance.
+        artifact_name: Name of the uploaded artifact.
+    """
+    import glob
+
+    import wandb
+
+    if wandb.run is None:
+        raise RuntimeError(
+            "No active W&B run. Call this from a context where wandb.init() has run, or pass "
+            "WANDB_MODE=offline / set up credentials first."
+        )
+    wandb.save(onnx_path, base_path=os.path.dirname(onnx_path))
+
+    # ``policy.onnx`` also matches ``policy.onnx.data``, which is exactly the sibling set needed.
+    artifact = wandb.Artifact(name=artifact_name, type="model")
+    for sibling in sorted(glob.glob(f"{onnx_path}*")):
+        artifact.add_file(sibling)
+    wandb.run.log_artifact(artifact)
+
+    if run_path:
+        wandb.run.config.update({"exported_from_run": run_path})
